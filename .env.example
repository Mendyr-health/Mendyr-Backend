# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Mendyr
ENVIRONMENT=local                 # local | dev | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-openssl-rand-hex-32
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres (see SETUP.md). For Supabase, replace this whole block with the values from
# Project Settings -> Database -> Connection string ("Session pooler" recommended — see
# SETUP.md's "Using Supabase Postgres" section for why) and flip the two flags below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mendyr
POSTGRES_PASSWORD=mendyr
POSTGRES_DB=mendyr
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
POSTGRES_SSL_REQUIRED=false        # true for Supabase/any hosted Postgres requiring TLS
DB_DISABLE_PREPARED_STATEMENT_CACHE=false   # true ONLY if POSTGRES_PORT is Supabase's 6543 Transaction pooler

# ─── Redis / Celery ──────────────────────────────────────────────────────────
# Set REDIS_ENABLED=false to run with no Redis at all: rate limiting falls back to an
# in-process store, OTP resend cooldown is skipped. Fine for early/local use; Celery
# worker/beat still need a real Redis if you actually run those processes.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60
REFRESH_TOKEN_COOKIE_ENABLED=true
REFRESH_TOKEN_COOKIE_NAME=refresh_token
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_DEV_BYPASS_CODE=000000        # only honoured when ENVIRONMENT=local

# ─── Marketplace rules ───────────────────────────────────────────────────────
PLATFORM_COMMISSION_PCT=20
GST_PCT=18
DEFAULT_SEARCH_RADIUS_KM=12
MAX_SEARCH_RADIUS_KM=30
BOOKING_OFFER_TTL_SECONDS=60
BOOKING_MAX_OFFER_ROUNDS=4
FREE_CANCELLATION_WINDOW_MINUTES=60
CANCELLATION_FEE_PCT=25
VISIT_CHECKIN_GEOFENCE_METERS=300

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ─── SMS (MSG91 / Twilio) ────────────────────────────────────────────────────
SMS_PROVIDER=console              # console | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MENDYR
MSG91_OTP_TEMPLATE_ID=

# ─── Push (FCM) ──────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# ─── Storage (S3) ────────────────────────────────────────────────────────────
S3_BUCKET=mendyr-dev
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
PRESIGNED_URL_TTL_SECONDS=900

# ─── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
